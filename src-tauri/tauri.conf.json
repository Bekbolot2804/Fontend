{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "handbook",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "distDir": "../dist",
    "devPath": "http://localhost:5173",
    "frontendDist": "../build",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "tauri": {
    "allowlist": {
      "fs": {
        "readFile": true,
        "writeFile": true
      }
    },
    "shell": {
        "open": true 
    }
  },
  "app": {
    "windows": [
      {
        "title": "client",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
