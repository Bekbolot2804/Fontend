{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "handbook",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "distDir": "../build",      
    "devPath": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "tauri": {                    
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": ["android"],    
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "android": {                
      "package": "com.helper.handbook"
    },
    "windows": [
      {
        "title": "handbook_app",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}